<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>org.webosbrew.devman</id>

  <name>webOS Dev Manager</name>
  <summary>Device and Dev Mode manager for webOS TV</summary>

  <metadata_license>CC0-1.0</metadata_license>
  <project_license>Apache-2.0</project_license>

  <developer id="org.webosbrew">
    <name>webOS Homebrew Team</name>
  </developer>

  <description>
    <p>
      webOS Dev Manager is a simple tool to manage developer mode enabled or rooted
      LG webOS TVs, without needing to install the LG SDK or IDE.
    </p>
    <p>Features:</p>
    <ul>
      <li>No need to install LG SDK or IDE</li>
      <li>Add a device without using the command line</li>
      <li>Install apps on your TV with a few clicks</li>
      <li>Configuration compatible with ares-cli</li>
      <li>Built-in file manager and terminal</li>
      <li>Dark mode follows system preferences</li>
    </ul>
  </description>

  <launchable type="desktop-id">org.webosbrew.devman.desktop</launchable>

  <categories>
    <category>Development</category>
    <category>Utility</category>
  </categories>

  <keywords>
    <keyword>webOS</keyword>
    <keyword>LG</keyword>
    <keyword>TV</keyword>
    <keyword>homebrew</keyword>
  </keywords>

